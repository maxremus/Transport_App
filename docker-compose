version: "3.8"

services:

  driver-service:
    image: maxremus/driver-service:latest
    ports:
      - "8081:8081"

  payment-service:
    image: maxremus/payment-service:latest
    ports:
      - "8082:8082"

  transport-saas:
    image: maxremus/transport_saas:latest
    ports:
      - "8083:8083"

  mysql:
    image: mysql:8
    environment:
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
