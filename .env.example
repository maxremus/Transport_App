# Copy this file to .env and fill in real values before running
# `docker compose up --build`

# MySQL database (same DB or separate DBs for transport-saas / driver-service)
DATABASE_URL=jdbc:mysql://HOST:PORT/DB_NAME
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# Shared secret for server-to-server calls between payment-service and
# transport-saas. Any long random string - just make sure it's IDENTICAL
# in both services.
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
